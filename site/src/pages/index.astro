---
const nav = [
  { label: '概览', href: '#hero' },
  { label: '能力', href: '#capabilities' },
  { label: '洞察', href: '#insights' },
  { label: '为什么', href: '#why' },
  { label: '怎么用', href: '#how' },
  { label: '下载', href: '#download' },
];
const stats = [
  { label: '动作库', value: '1,324' },
  { label: '生成计划', value: '5 秒' },
  { label: '本地运行', value: '100%' },
  { label: '订阅', value: '0' },
];
const insights = [
  {
    tag: 'AI 编排',
    title: '一段话,一份完整 N 天计划',
    body: '"练背,只有哑铃,初学者" → 一份 4 天的拉力计划,带组数、次数、休息、要点。',
  },
  {
    tag: '本地化',
    title: 'API key 只在本机,不上传',
    body: '设置页填一次,以后所有计划 + 历史打卡都存 ~/Library/Application Support/Ritual/,无需注册。',
  },
  {
    tag: '训练模式',
    title: '接电话回来,不乱节拍',
    body: '全屏 + 倒计时 + 语音 + GIF + BGM;暂停/继续会从原 tick 接着走。',
  },
];
const whyItems = [
  { h: '中文意图 → 中文计划', p: '对话式意图解析,不是填表式表单。' },
  { h: '编排即动作,而非幻灯片', p: '每组的离心/向心/顶峰时间都拆开,不是模糊的"快推慢放"。' },
  { h: '1324 个真人 GIF', p: '每动作库里都有人 GIF,不用脑补姿势。' },
  { h: '不锁设备', p: '完全本地 SQLite;搬家、换电脑,导出导入就好。' },
];
const steps = [
  { n: '01', h: '下载双击', p: 'GitHub Release 拉 dmg,拖进 Applications,双击。' },
  { n: '02', h: '填一次 API key', p: '设置页填你自己的 base_url + key,之后不再上传。' },
  { n: '03', h: '说一句"想练什么"', p: '生成页一句话意图 + 可选目标肌 / 器械,5 秒出完整 N 天计划。' },
  { n: '04', h: '点开始,跟着做', p: '全屏训练模式:倒计时 + 语音 + GIF + BGM,接电话也不乱。' },
];
const lastUpdated = '2026-07-29';
---
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ritual — 把 AI 编排健身教练装进你自己的 Mac</title>
    <meta name="description" content="打开 app,说一句想练什么,5 秒生成一份完整的训练计划 — 然后跟着做。Mac .app 双击即用,完全本地运行。" />
    <link rel="icon" type="image/svg+xml" href="/ritual/favicon.svg" />
    <meta name="theme-color" content="#f5efe6" />
    <meta property="og:title" content="Ritual — AI 编排训练计划 + 沉浸式训练模式" />
    <meta property="og:description" content='把"打开健身 app 选计划"变成"5 秒生成 + 直接开练"。' />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,500;1,9..144,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <style is:global>
      *,*::before,*::after { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        background: #f5efe6;
        color: #1a1a1a;
        font-family: 'Inter', -apple-system, system-ui, sans-serif;
        font-size: 16px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      .wrap { width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 32px; }
      @media (max-width: 720px) { .wrap { padding: 0 20px; } }
      a { color: inherit; text-decoration: none; }
      img, svg { max-width: 100%; display: block; }
      .display {
        font-family: 'Fraunces', 'Times New Roman', serif;
        font-weight: 500;
        font-style: normal;
        letter-spacing: -0.025em;
        line-height: 1.05;
      }
      .italic { font-style: italic; }
      .eyebrow {
        font-family: ui-monospace, 'JetBrains Mono', Menlo, monospace;
        font-size: 11px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: #8a7e6e;
      }
      .mono { font-family: ui-monospace, 'JetBrains Mono', Menlo, monospace; }

      /* ── nav ────────────────────── */
      .nav {
        position: sticky; top: 0; z-index: 50;
        background: rgba(245, 239, 230, 0.86);
        backdrop-filter: saturate(180%) blur(14px);
        -webkit-backdrop-filter: saturate(180%) blur(14px);
        border-bottom: 1px solid rgba(26, 26, 26, 0.06);
      }
      .nav__inner {
        display: flex; align-items: center; justify-content: space-between;
        gap: 16px; padding: 16px 0;
      }
      .nav__brand {
        display: flex; align-items: center; gap: 10px;
        font-family: 'Fraunces', serif;
        font-size: 18px; font-weight: 700;
      }
      .nav__mark { width: 26px; height: 26px; }
      .nav__links {
        display: flex; gap: 4px; padding: 4px;
        background: rgba(26, 26, 26, 0.05);
        border-radius: 999px;
      }
      .nav__link {
        padding: 6px 14px; border-radius: 999px;
        font-size: 13px; font-weight: 500; color: #1a1a1a;
      }
      .nav__link:hover { background: rgba(26, 26, 26, 0.06); }
      .nav__cta {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 10px 20px;
        border: 1px solid rgba(26, 26, 26, 0.18);
        border-radius: 999px; font-size: 13px; font-weight: 500;
      }
      .nav__cta:hover { background: rgba(26, 26, 26, 0.04); }
      @media (max-width: 720px) {
        .nav__links { display: none; }
        .nav__brand span { display: none; }
      }

      /* ── HERO(图 1) ────────────── */
      .hero {
        display: grid; grid-template-columns: 1.1fr 1fr;
        gap: 56px; padding: 88px 0 48px; align-items: end;
      }
      .hero h1 {
        font-size: clamp(44px, 6.4vw, 84px);
        line-height: 1.02; margin: 16px 0 36px;
      }
      .hero h1 em { color: #C04A2C; }
      .hero__ctas { display: flex; gap: 18px; align-items: center; flex-wrap: wrap; }
      .btn {
        display: inline-flex; align-items: center; gap: 10px;
        padding: 14px 24px; border-radius: 999px;
        font-weight: 600; font-size: 14px;
        letter-spacing: 0.02em; text-transform: uppercase;
        transition: transform 0.12s, background 0.15s;
      }
      .btn:hover { transform: translateY(-1px); }
      .btn--black { background: #1a1a1a; color: #f5efe6; }
      .btn--black:hover { background: #2a2a2a; }
      .btn--ghost { background: transparent; color: #1a1a1a; }
      .btn--ghost:hover { background: rgba(26, 26, 26, 0.05); }
      .btn__arrow { width: 18px; height: 18px; }

      .hero__art {
        background: #efe6d8;
        border-radius: 20px; overflow: hidden;
        aspect-ratio: 5/4;
        position: relative;
      }
      .hero__art svg { width: 100%; height: 100%; }

      /* ── metric strip(图 1 底部) ────── */
      .stats {
        display: grid; grid-template-columns: repeat(4, 1fr);
        gap: 18px; padding: 48px 0 80px;
      }
      .stat {
        border: 1px solid rgba(26, 26, 26, 0.08);
        border-radius: 16px; padding: 22px 24px 26px;
        background: rgba(255, 253, 248, 0.6);
        display: flex; flex-direction: column; gap: 6px;
      }
      .stat__value {
        font-family: 'Fraunces', serif;
        font-size: 40px; font-weight: 500;
        letter-spacing: -0.02em; line-height: 1.1;
      }
      @media (max-width: 720px) { .stats { grid-template-columns: repeat(2, 1fr); } }

      /* ── 黑底 CTA banner(图 2 顶部) ───── */
      .cta-bar {
        background: #1a1a1a; color: #f5efe6;
        border-radius: 20px;
        padding: 28px 36px;
        display: flex; align-items: center; justify-content: space-between;
        gap: 24px;
      }
      .cta-bar p { font-size: 19px; margin: 0; flex: 1; font-weight: 500; }
      .cta-bar .btn { background: #f5efe6; color: #1a1a1a; }
      .cta-bar .btn:hover { background: #ffffff; }

      /* ── insights(图 2 中部) ────────── */
      .section-head {
        display: flex; align-items: end; justify-content: space-between;
        gap: 24px; padding: 80px 0 24px;
      }
      .section-head h2 {
        font-size: clamp(40px, 5vw, 60px);
        margin: 8px 0 0;
      }
      .section-head__right {
        font-family: ui-monospace, monospace;
        font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase;
        color: #1a1a1a; padding-bottom: 8px;
      }
      .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
      .card {
        border: 1px solid rgba(26, 26, 26, 0.08);
        border-radius: 16px; padding: 26px 28px 22px;
        display: flex; flex-direction: column; gap: 16px;
        background: rgba(255, 253, 248, 0.6);
        min-height: 280px;
      }
      .card h3 {
        font-size: 22px; line-height: 1.22;
        margin: 0;
      }
      .card p { margin: 0; color: #4a4540; font-size: 14px; line-height: 1.55; }
      .card .line {
        margin-top: auto;
        padding-top: 18px; border-top: 1px solid rgba(26, 26, 26, 0.1);
        display: flex; justify-content: space-between; align-items: center;
        font-family: ui-monospace, monospace;
        font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
        color: #8a7e6e;
      }
      .card .line a:hover { color: #C04A2C; }
      @media (max-width: 720px) { .cards { grid-template-columns: 1fr; } }

      /* ── why(图 3)+ photo ──────────── */
      .why {
        display: grid; grid-template-columns: 1.05fr 1fr;
        gap: 56px; padding: 80px 0; align-items: center;
      }
      .why__text h2 {
        font-size: clamp(40px, 5.4vw, 64px); margin: 16px 0 36px;
      }
      .why__list { display: flex; flex-direction: column; }
      .why__row {
        display: grid; grid-template-columns: 28px 1fr; gap: 14px;
        padding: 24px 0; border-top: 1px solid rgba(26, 26, 26, 0.1);
      }
      .why__row:last-of-type { border-bottom: 1px solid rgba(26, 26, 26, 0.1); }
      .why__check {
        width: 22px; height: 22px;
        border: 1.5px solid rgba(26, 26, 26, 0.4);
        border-radius: 999px;
        display: grid; place-items: center; margin-top: 2px;
      }
      .why__check::after {
        content: ''; width: 6px; height: 10px;
        border-right: 1.5px solid #C04A2C;
        border-bottom: 1.5px solid #C04A2C;
        transform: rotate(45deg) translate(-1px, -1px);
      }
      .why__row h3 { font-size: 19px; margin: 0 0 4px; }
      .why__row p { margin: 0; color: #4a4540; font-size: 14px; line-height: 1.55; }
      .why__photo {
        background: linear-gradient(140deg, #C04A2C 0%, #7a2e1a 100%);
        border-radius: 24px;
        aspect-ratio: 4 / 5;
        position: relative; overflow: hidden;
      }
      @media (max-width: 720px) { .why { grid-template-columns: 1fr; gap: 32px; } }

      /* ── how we work(图 3 底部 + 图 4) ──── */
      .steps {
        border: 1px solid rgba(26, 26, 26, 0.08);
        border-radius: 20px;
        background: rgba(255, 253, 248, 0.6);
      }
      .step {
        display: grid; grid-template-columns: 80px 1fr; gap: 24px;
        padding: 32px 36px;
      }
      .step + .step { border-top: 1px solid rgba(26, 26, 26, 0.08); }
      .step__n {
        font-family: ui-monospace, monospace;
        font-size: 13px; color: #8a7e6e;
        letter-spacing: 0.18em; padding-top: 8px;
      }
      .step h3 {
        font-size: 26px; margin: 0 0 8px;
        font-family: 'Fraunces', serif; font-weight: 500;
        letter-spacing: -0.015em;
      }
      .step p { margin: 0; color: #4a4540; line-height: 1.55; font-size: 15px; }
      @media (max-width: 720px) { .step { grid-template-columns: 1fr; gap: 6px; padding: 22px; } }

      /* ── download ──────────────────── */
      .download-grid {
        display: grid; grid-template-columns: 1.4fr 1fr 1fr;
        gap: 18px;
      }
      .download {
        border-radius: 18px; padding: 28px;
        display: flex; flex-direction: column; gap: 14px;
        min-height: 200px;
      }
      .download--main { background: #1a1a1a; color: #f5efe6; }
      .download--main h3 { color: #f5efe6; }
      .download--main .line { border-color: rgba(245,239,230,0.15); color: #8a7e6e; }
      .download--light {
        background: rgba(255, 253, 248, 0.6);
        border: 1px solid rgba(26, 26, 26, 0.08);
      }
      .download h3 {
        font-family: 'Fraunces', serif;
        font-size: 24px; margin: 0; font-weight: 500;
        letter-spacing: -0.015em;
      }
      .download p { margin: 0; font-size: 13px; line-height: 1.55; }
      .download .line {
        margin-top: auto;
        padding-top: 16px; border-top: 1px solid rgba(26, 26, 26, 0.1);
        display: flex; justify-content: space-between;
        font-family: ui-monospace, monospace;
        font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
        color: #8a7e6e;
      }
      @media (max-width: 720px) { .download-grid { grid-template-columns: 1fr; } }

      /* ── FAQ ────────────────────────── */
      .faq { display: flex; flex-direction: column; gap: 12px; }
      .faq details {
        border: 1px solid rgba(26, 26, 26, 0.08); border-radius: 14px;
        padding: 20px 24px; background: rgba(255, 253, 248, 0.6);
      }
      .faq summary {
        cursor: pointer; font-weight: 600; font-size: 16px;
        list-style: none;
        display: flex; justify-content: space-between; align-items: center;
      }
      .faq summary::-webkit-details-marker { display: none; }
      .faq summary::after {
        content: '+'; font-size: 22px; color: #8a7e6e;
        transition: transform 0.18s;
      }
      .faq details[open] summary::after { content: '−'; }
      .faq p { color: #4a4540; margin: 14px 0 0; line-height: 1.55; }

      /* ── footer ─────────────────────── */
      footer {
        margin-top: 96px; padding: 48px 0 56px;
        border-top: 1px solid rgba(26, 26, 26, 0.08);
        display: flex; justify-content: space-between;
        gap: 24px; flex-wrap: wrap;
        color: #4a4540; font-size: 13px;
      }
      footer a:hover { color: #C04A2C; }
      footer .links { display: flex; gap: 24px; flex-wrap: wrap; }
    </style>
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav__inner">
        <a href="#hero" class="nav__brand">
          <svg class="nav__mark" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
            <circle cx="16" cy="16" r="15" fill="#1a1a1a"/>
            <text x="16" y="22" text-anchor="middle" font-family="Fraunces, serif" font-style="italic" font-weight="700" font-size="20" fill="#C04A2C">R</text>
          </svg>
          <span>Ritual</span>
        </a>
        <nav class="nav__links">
          {nav.map((n) => <a class="nav__link" href={n.href}>{n.label}</a>)}
        </nav>
        <a class="nav__cta" href="https://github.com/young920/ritual" target="_blank" rel="noopener">
          GitHub ↗
        </a>
      </div>
    </header>

    <main class="wrap">
      <!-- ─── HERO(图 1) ─────────────────────── -->
      <section id="hero" class="hero">
        <div>
          <p class="eyebrow">RITUAL · 本地 AI 健身教练 · 2026</p>
          <h1 class="display">
            打开 app,<br/>
            说一句<em class="italic">想练什么。</em>
          </h1>
          <div class="hero__ctas">
            <a class="btn btn--black" href="#download">
              下载 macOS
              <svg class="btn__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
                <path d="M5 19h14M13 5v10M13 15l-4-4M13 15l4-4"/>
              </svg>
            </a>
            <a class="btn btn--ghost" href="#how">
              看看怎么用
              <svg class="btn__arrow" viewBox="0 0 24 24" fill="currentColor">
                <circle cx="12" cy="12" r="11" fill="#1a1a1a"/>
                <polygon points="10,8 16,12 10,16" fill="#f5efe6"/>
              </svg>
            </a>
          </div>
        </div>
        <div class="hero__art">
          <!-- 密集线稿插画:现代城市 + 工作桌 + 飞机 + 物件博物馆 -->
          <svg viewBox="0 0 600 480" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <pattern id="hatch" patternUnits="userSpaceOnUse" width="4" height="4" patternTransform="rotate(45)">
                <line x1="0" y1="0" x2="0" y2="4" stroke="#1a1a1a" stroke-width="0.4" opacity="0.55"/>
              </pattern>
              <pattern id="hatchL" patternUnits="userSpaceOnUse" width="5" height="5" patternTransform="rotate(-30)">
                <line x1="0" y1="0" x2="0" y2="5" stroke="#1a1a1a" stroke-width="0.25" opacity="0.4"/>
              </pattern>
              <pattern id="hatchXL" patternUnits="userSpaceOnUse" width="6" height="6" patternTransform="rotate(0)">
                <line x1="0" y1="0" x2="0" y2="6" stroke="#1a1a1a" stroke-width="0.3" opacity="0.5"/>
              </pattern>
            </defs>
            <rect width="600" height="480" fill="#efe6d8"/>

            <!-- ── 飞过的鸟 ── -->
            <g stroke="#1a1a1a" stroke-width="0.9" fill="none">
              <path d="M70 60 Q78 50 86 60 Q94 50 102 60"/>
              <path d="M460 50 Q466 43 472 50 Q478 43 484 50"/>
            </g>

            <!-- ── 左下角:RITUAL EST. 2026 ── -->
            <g font-family="Fraunces, serif" font-style="italic" fill="#1a1a1a">
              <text x="60" y="58" font-size="14" font-weight="700">RITUAL</text>
              <text x="60" y="74" font-size="10" opacity="0.6" letter-spacing="2">EST. 2026</text>
            </g>

            <!-- ── 右上角:FIG.01 ── -->
            <g font-family="ui-monospace, monospace" fill="#1a1a1a" font-size="9" letter-spacing="0.6">
              <text x="510" y="50">FIG.01</text>
              <text x="510" y="62" opacity="0.6">DAILY PRACTICE</text>
              <rect x="544" y="44" width="32" height="6" fill="#C04A2C"/>
              <line x1="544" y1="56" x2="576" y2="56" stroke="#C04A2C" stroke-width="1"/>
            </g>

            <!-- ── 后景:城市天际线 ── -->
            <g fill="url(#hatchL)" stroke="#1a1a1a" stroke-width="0.8">
              <rect x="50" y="240" width="34" height="160"/>
              <rect x="86" y="200" width="42" height="200"/>
              <rect x="130" y="225" width="30" height="175"/>
              <rect x="162" y="180" width="48" height="220"/>
              <rect x="212" y="155" width="38" height="245"/>
              <rect x="252" y="200" width="32" height="200"/>
              <rect x="286" y="170" width="44" height="230"/>
              <rect x="332" y="195" width="34" height="205"/>
              <rect x="368" y="140" width="52" height="260"/>
              <rect x="422" y="185" width="38" height="215"/>
              <rect x="462" y="205" width="34" height="195"/>
              <rect x="498" y="175" width="44" height="225"/>
              <rect x="544" y="210" width="32" height="190"/>
            </g>
            <!-- 建筑窗户(细节) -->
            <g fill="#efe6d8">
              <rect x="92" y="215" width="3" height="3"/><rect x="100" y="215" width="3" height="3"/><rect x="108" y="215" width="3" height="3"/><rect x="116" y="215" width="3" height="3"/>
              <rect x="92" y="225" width="3" height="3"/><rect x="100" y="225" width="3" height="3"/><rect x="108" y="225" width="3" height="3"/><rect x="116" y="225" width="3" height="3"/>
              <rect x="92" y="235" width="3" height="3"/><rect x="100" y="235" width="3" height="3"/><rect x="108" y="235" width="3" height="3"/><rect x="116" y="235" width="3" height="3"/>
              <rect x="170" y="195" width="3" height="3"/><rect x="178" y="195" width="3" height="3"/><rect x="186" y="195" width="3" height="3"/><rect x="194" y="195" width="3" height="3"/>
              <rect x="170" y="205" width="3" height="3"/><rect x="178" y="205" width="3" height="3"/><rect x="186" y="205" width="3" height="3"/><rect x="194" y="205" width="3" height="3"/>
